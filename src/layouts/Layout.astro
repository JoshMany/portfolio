---
import {
  getHTMLTextDir,
  getIntlayer,
  getLocaleLang,
  type LocalesValues,
} from "intlayer";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";

interface Props {
  locale: LocalesValues;
}

const { locale } = Astro.props;
const lang = getLocaleLang(locale);
const dir = getHTMLTextDir(locale);

const { title: siteTitle } = await getIntlayer("layout", locale);
const nav = await getIntlayer("nav", locale);
const footer = await getIntlayer("footer", locale);

const description =
  locale === "en"
    ? "Full Stack Engineer — React, TypeScript, Python, Django, Next.js. Portfolio & resume."
    : "Full Stack Engineer — React, TypeScript, Python, Django, Next.js. Portafolio y currículum.";
const ogImage = "/og-image.png";
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{siteTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Canonical -->
    <link
      rel="canonical"
      href={Astro.site
        ? new URL(Astro.url.pathname, Astro.site).href
        : Astro.url.href}
    />
  </head>
  <body class="bg-black text-white">
    <Navbar locale={locale} content={nav} currentPath={Astro.url.pathname} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} content={footer} />
  </body>
</html>
