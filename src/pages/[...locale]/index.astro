---
import AboutSection from "@/components/index/sections/AboutSection.astro";
import StackSection from "@/components/index/sections/StackSection.astro";
import ExperienceSection from "@/components/index/sections/ExperienceSection.astro";
import ProjectsSection from "@/components/index/sections/ProjectsSection.astro";
import GitHubSection from "@/components/index/sections/GitHubSection.astro";
import EducationSection from "@/components/index/sections/EducationSection.astro";
import CertificatesSection from "@/components/index/sections/CertificatesSection.astro";
import Layout from "@/layouts/Layout.astro";
import "@/styles/global.css";
import {
  getIntlayer,
  getLocaleFromPath,
  getPrefix,
  localeMap,
  type LocalesValues,
} from "intlayer";
import LanguagesSection from "@/components/index/sections/LanguagesSection.astro";

export const getStaticPaths = () => {
  return localeMap(({ locale }) => ({
    params: { locale: getPrefix(locale).localePrefix },
  }));
};

const locale = getLocaleFromPath(Astro.url.pathname) as LocalesValues;
const c = await getIntlayer("index", locale);
const footer = await getIntlayer("footer", locale);

const marqueeItems = [
  "FULL STACK ENGINEER",
  "REACT",
  "TYPESCRIPT",
  "PYTHON",
  "DJANGO",
  "NEXT.JS",
  "LARAVEL",
  "NODE.JS",
  "POSTGRESQL",
  "TAILWIND",
  "DOCKER",
  "THREE.JS",
  "ASTRO",
];
---

<Layout locale={locale}>
  <!-- ═══════════════ HERO ═══════════════ -->
  <section class="border-line bg-paper relative border-b">
    <div class="px-5 py-16 sm:px-8 md:px-10 md:py-28">
      <div class="max-w-3xl">
        <p
          class="text-ink-soft text-caption font-mono tracking-widest uppercase"
        >
          <span class="text-navy">/</span>
          {c.hero.subtitle}<span class="blink text-navy">_</span>
        </p>
        <h1 class="text-mega text-ink text-display mt-6">
          {c.hero.firstName}
          <br />
          <span class="text-navy">{c.hero.lastName}</span>
        </h1>
        <p class="text-ink-soft text-body mt-7 max-w-xl">
          {c.hero.description}
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a
            href="/José_Manuel_Muñoz_García_Resume_2026.pdf"
            download
            class="bg-navy border-navy group hover:text-navy! text-caption w-full border px-6 py-3.5 text-center font-mono text-white! uppercase transition-all duration-150 hover:bg-white sm:w-auto"
            ><span class="text-cream group-hover:text-navy">[↓]</span>{" "}
            {c.hero.downloadCv}</a
          >
          <a
            href="#contact"
            class="border-navy group hover:bg-navy text-navy! text-caption w-full border bg-white px-6 py-3.5 text-center font-mono uppercase transition-all duration-150 hover:text-white! sm:w-auto"
            ><span class="text-navy group-hover:text-white">[→]</span>{" "}
            {c.hero.contact}</a
          >
        </div>
      </div>
      <div
        class="border-line text-ink-faint text-meta mt-14 flex flex-wrap items-center gap-x-6 gap-y-2 border-t pt-4 font-mono uppercase"
      >
        <span class="flex items-center gap-1.5"
          ><span class="win-dot win-dot--radio blink"></span>STATUS:OPEN</span
        >
        <span>BASE::{footer.location}</span>
        <span>EMAIL::{footer.email}</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════ TICKER ═══════════════ -->
  <div class="border-line bg-navy overflow-hidden border-b py-2.5">
    <div class="animate-marquee flex w-max whitespace-nowrap">
      <div
        class="text-cream/90 text-meta flex items-center gap-6 pr-6 font-mono uppercase"
      >
        {
          marqueeItems.map((m) => (
            <span class="flex items-center gap-6">
              <>
                <span>{m}</span>
                <span class="text-peri">/</span>
              </>
            </span>
          ))
        }
      </div>
      <div
        class="text-cream/90 text-meta flex items-center gap-6 pr-6 font-mono uppercase"
        aria-hidden="true"
      >
        {
          marqueeItems.map((m) => (
            <span class="flex items-center gap-6">
              <>
                <span>{m}</span>
                <span class="text-peri">/</span>
              </>
            </span>
          ))
        }
      </div>
    </div>
  </div>

  <AboutSection />

  <StackSection />

  <ExperienceSection />

  <ProjectsSection />

  <GitHubSection />

  <LanguagesSection />

  <CertificatesSection />

  <EducationSection />
</Layout>
