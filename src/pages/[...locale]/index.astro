---
import Layout from "@/layouts/Layout.astro";
import "@/styles/global.css";
import {
  getIntlayer,
  getLocaleFromPath,
  getPrefix,
  localeMap,
  type LocalesValues,
} from "intlayer";
import ThreeScene from "@/components/ThreeScene.astro";

export const getStaticPaths = () => {
  return localeMap(({ locale }) => ({
    params: { locale: getPrefix(locale).localePrefix },
  }));
};

const locale = getLocaleFromPath(Astro.url.pathname) as LocalesValues;
const c = await getIntlayer("index", locale);
---

<Layout locale={locale}>
  <section
    class="relative flex min-h-screen flex-col justify-end md:justify-center"
  >
    <ThreeScene />
    <div class="relative z-10 px-6 pb-10 md:ml-[50%] md:pr-16 md:pb-0 lg:pr-24">
      <p
        class="text-sm tracking-[0.25em] text-stone-500 uppercase md:text-base"
      >
        {c.hero.subtitle}
      </p>
      <h1
        class="mt-2 text-5xl leading-none font-bold text-stone-900 md:text-7xl lg:text-8xl"
      >
        {c.hero.firstName}{" "}
        <span class="font-serif font-normal italic">{c.hero.lastName}</span>
      </h1>
      <p
        class="mt-5 max-w-md text-base leading-relaxed text-stone-500 md:text-lg"
      >
        {c.hero.description}
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/José_Manuel_Muñoz_García_Resume_2026.pdf"
          download
          class="inline-flex items-center gap-2 rounded-md bg-stone-900 px-5 py-3 text-sm font-medium text-[#e4dec0] transition hover:bg-stone-700"
          ><svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 10v6m0 0-3-3m3 3 3-3m2 8H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2Z"
            ></path></svg
          >{c.hero.downloadCv}</a
        >
        <a
          href="#contact"
          class="inline-flex items-center gap-2 rounded-md border border-stone-400 px-5 py-3 text-sm font-medium text-stone-700 transition hover:border-stone-600 hover:text-stone-900"
          >{c.hero.contact}</a
        >
      </div>
    </div>
    <div
      class="absolute bottom-6 left-1/2 z-10 hidden -translate-x-1/2 md:block"
    >
      <span class="block h-10 w-6 rounded-full border-2 border-stone-400"
        ><span
          class="mx-auto mt-2 block h-1.5 w-1.5 animate-bounce rounded-full bg-stone-400"
        ></span></span
      >
    </div>
  </section>

  <div class="md:ml-[50%]">
    <!-- ABOUT -->
    <section id="about" class="px-6 py-20 md:pr-16 lg:pr-24">
      <span class="text-xs tracking-[0.3em] text-stone-400 uppercase"
        >{c.about.sectionLabel}</span
      >
      <h2 class="mt-2 text-3xl font-bold text-stone-900 md:text-4xl">
        {c.about.heading}
      </h2>
      <div class="mt-6 max-w-lg space-y-4 leading-relaxed text-stone-600">
        <p>
          {c.about.p1}
        </p>
        <p>
          {c.about.p2}
        </p>
      </div>
      <div class="mt-10 grid max-w-sm grid-cols-3 gap-6">
        <div>
          <p class="text-3xl font-bold text-stone-900">{c.about.stat1Num}</p><p
            class="mt-1 text-xs leading-tight text-stone-400"
          >
            {c.about.stat1Label}
          </p>
        </div>
        <div>
          <p class="text-3xl font-bold text-stone-900">{c.about.stat2Num}</p><p
            class="mt-1 text-xs leading-tight text-stone-400"
          >
            {c.about.stat2Label}
          </p>
        </div>
        <div>
          <p class="text-3xl font-bold text-stone-900">{c.about.stat3Num}</p><p
            class="mt-1 text-xs leading-tight text-stone-400"
          >
            {c.about.stat3Label}
          </p>
        </div>
      </div>
    </section>

    <!-- TECH STACK -->
    <section id="stack" class="px-6 py-16 md:pr-16 lg:pr-24">
      <span class="text-xs tracking-[0.3em] text-stone-400 uppercase"
        >{c.stack.sectionLabel}</span
      >
      <h2 class="mt-2 text-3xl font-bold text-stone-900 md:text-4xl">
        {c.stack.heading}
      </h2>
      <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {
          [
            "TypeScript",
            "React",
            "Next.js",
            "Python",
            "Django",
            "Laravel",
            "PHP",
            "Node.js",
            "PostgreSQL",
            "MySQL",
            "Tailwind",
            "Docker",
            "Git",
            "REST APIs",
            "Three.js",
            "Astro",
          ].map((t) => (
            <div class="rounded-md border border-stone-300 bg-stone-100/50 px-4 py-3 text-center text-sm font-medium text-stone-700 transition hover:border-stone-400 hover:bg-stone-100">
              {t}
            </div>
          ))
        }
      </div>
    </section>

    <!-- TIMELINE -->
    <section id="timeline" class="px-6 py-16 md:pr-16 lg:pr-24">
      <span class="text-xs tracking-[0.3em] text-stone-400 uppercase"
        >{c.timeline.sectionLabel}</span
      >
      <h2 class="mt-2 text-3xl font-bold text-stone-900 md:text-4xl">
        {c.timeline.heading}
      </h2>
      <div class="mt-10 space-y-0">
        <div class="relative border-l-2 border-stone-300 pb-10 pl-8">
          <span
            class="absolute top-0 -left-1.25 block h-2 w-2 rounded-full bg-stone-500"
          ></span><p class="text-sm font-medium text-stone-400">
            {c.timeline.t1Year}
          </p><h3 class="mt-1 text-lg font-semibold text-stone-900">
            {c.timeline.t1Role}
          </h3><p class="text-sm font-medium text-stone-500">
            {c.timeline.t1Company}
          </p><p class="mt-2 text-sm leading-relaxed text-stone-600">
            {c.timeline.t1Desc}
          </p>
        </div>
        <div class="relative border-l-2 border-stone-300 pb-10 pl-8">
          <span
            class="absolute top-0 -left-1.25 block h-2 w-2 rounded-full bg-stone-500"
          ></span><p class="text-sm font-medium text-stone-400">
            {c.timeline.t2Year}
          </p><h3 class="mt-1 text-lg font-semibold text-stone-900">
            {c.timeline.t2Role}
          </h3><p class="text-sm font-medium text-stone-500">
            {c.timeline.t2Company}
          </p><p class="mt-2 text-sm leading-relaxed text-stone-600">
            {c.timeline.t2Desc}
          </p>
        </div>
        <div class="relative border-l-2 border-stone-300 pb-10 pl-8 last:pb-0">
          <span
            class="absolute top-0 -left-1.25 block h-2 w-2 rounded-full bg-stone-500"
          ></span><p class="text-sm font-medium text-stone-400">
            {c.timeline.t3Year}
          </p><h3 class="mt-1 text-lg font-semibold text-stone-900">
            {c.timeline.t3Role}
          </h3><p class="text-sm font-medium text-stone-500">
            {c.timeline.t3Company}
          </p><p class="mt-2 text-sm leading-relaxed text-stone-600">
            {c.timeline.t3Desc}
          </p>
        </div>
        <div class="relative border-l-2 border-stone-300 pb-10 pl-8 last:pb-0">
          <span
            class="absolute top-0 -left-1.25 block h-2 w-2 rounded-full bg-stone-500"
          ></span><p class="text-sm font-medium text-stone-400">
            {c.timeline.t4Year}
          </p><h3 class="mt-1 text-lg font-semibold text-stone-900">
            {c.timeline.t4Role}
          </h3><p class="text-sm font-medium text-stone-500">
            {c.timeline.t4Company}
          </p><p class="mt-2 text-sm leading-relaxed text-stone-600">
            {c.timeline.t4Desc}
          </p>
        </div>
      </div>
    </section>

    <!-- PROJECTS -->
    <section id="projects" class="px-6 py-16 md:pr-16 lg:pr-24">
      <span class="text-xs tracking-[0.3em] text-stone-400 uppercase"
        >{c.projects.sectionLabel}</span
      >
      <h2 class="mt-2 text-3xl font-bold text-stone-900 md:text-4xl">
        {c.projects.heading}
      </h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        <div
          class="group rounded-xl border border-stone-300 bg-white/60 p-6 transition hover:border-stone-400 hover:shadow-md"
        >
          <p class="text-xs font-medium text-stone-400">
            {c.projects.p1Tags}
          </p><h3 class="mt-2 text-lg font-semibold text-stone-900">
            {c.projects.p1Title}
          </h3><p class="mt-2 text-sm leading-relaxed text-stone-600">
            {c.projects.p1Desc}
          </p><span
            class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-stone-500 transition group-hover:text-stone-700"
            >{c.projects.viewLabel}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m9 5 7 7-7 7"></path></svg
            ></span
          >
        </div>
        <div
          class="group rounded-xl border border-stone-300 bg-white/60 p-6 transition hover:border-stone-400 hover:shadow-md"
        >
          <p class="text-xs font-medium text-stone-400">
            {c.projects.p2Tags}
          </p><h3 class="mt-2 text-lg font-semibold text-stone-900">
            {c.projects.p2Title}
          </h3><p class="mt-2 text-sm leading-relaxed text-stone-600">
            {c.projects.p2Desc}
          </p><span
            class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-stone-500 transition group-hover:text-stone-700"
            >{c.projects.viewLabel}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m9 5 7 7-7 7"></path></svg
            ></span
          >
        </div>
        <div
          class="group rounded-xl border border-stone-300 bg-white/60 p-6 transition hover:border-stone-400 hover:shadow-md"
        >
          <p class="text-xs font-medium text-stone-400">
            {c.projects.p3Tags}
          </p><h3 class="mt-2 text-lg font-semibold text-stone-900">
            {c.projects.p3Title}
          </h3><p class="mt-2 text-sm leading-relaxed text-stone-600">
            {c.projects.p3Desc}
          </p><span
            class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-stone-500 transition group-hover:text-stone-700"
            >{c.projects.viewLabel}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m9 5 7 7-7 7"></path></svg
            ></span
          >
        </div>
        <div
          class="group rounded-xl border border-stone-300 bg-white/60 p-6 transition hover:border-stone-400 hover:shadow-md"
        >
          <p class="text-xs font-medium text-stone-400">
            {c.projects.p4Tags}
          </p><h3 class="mt-2 text-lg font-semibold text-stone-900">
            {c.projects.p4Title}
          </h3><p class="mt-2 text-sm leading-relaxed text-stone-600">
            {c.projects.p4Desc}
          </p><span
            class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-stone-500 transition group-hover:text-stone-700"
            >{c.projects.viewLabel}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m9 5 7 7-7 7"></path></svg
            ></span
          >
        </div>
      </div>
    </section>

    <!-- GITHUB -->
    <section class="px-6 py-16 md:pr-16 lg:pr-24">
      <span class="text-xs tracking-[0.3em] text-stone-400 uppercase"
        >{c.github.sectionLabel}</span
      >
      <h2 class="mt-2 text-3xl font-bold text-stone-900 md:text-4xl">
        {c.github.heading}
      </h2>
      <div
        class="mt-6 overflow-hidden rounded-xl border border-stone-300 bg-white/60 p-4"
      >
        <img
          src={`https://ghchart.rshah.org/${c.github.username}`}
          alt="GitHub contribution graph"
          class="w-full"
          loading="lazy"
        />
      </div>
      <a
        href={`https://github.com/${c.github.username}`}
        target="_blank"
        rel="noopener"
        class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-stone-600 transition hover:text-stone-900"
        ><svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          fill="currentColor"
          viewBox="0 0 24 24"
          ><path
            d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"
          ></path></svg
        > github.com/{c.github.username}</a
      >
    </section>

    <!-- LANGUAGES & CERTIFICATES -->
    <section class="px-6 py-16 md:pr-16 lg:pr-24">
      <div class="grid gap-12 sm:grid-cols-2">
        <div>
          <span class="text-xs tracking-[0.3em] text-stone-400 uppercase"
            >{c.languages.sectionLabel}</span
          >
          <h2 class="mt-2 text-3xl font-bold text-stone-900 md:text-4xl">
            {c.languages.heading}
          </h2>
          <div class="mt-6 space-y-4">
            <div>
              <div class="flex justify-between text-sm">
                <span class="font-medium text-stone-800"
                  >{c.languages.l1Name}</span
                ><span class="text-stone-500">{c.languages.l1Level}</span>
              </div><div class="mt-1.5 h-2 w-full rounded-full bg-stone-200">
                <div
                  class="h-2 rounded-full bg-stone-600 transition-all"
                  style={`width:${c.languages.l1Pct}`}
                >
                </div>
              </div>
            </div>
            <div>
              <div class="flex justify-between text-sm">
                <span class="font-medium text-stone-800"
                  >{c.languages.l2Name}</span
                ><span class="text-stone-500">{c.languages.l2Level}</span>
              </div><div class="mt-1.5 h-2 w-full rounded-full bg-stone-200">
                <div
                  class="h-2 rounded-full bg-stone-600 transition-all"
                  style={`width:${c.languages.l2Pct}`}
                >
                </div>
              </div>
            </div>
          </div>
        </div>
        <div>
          <span class="text-xs tracking-[0.3em] text-stone-400 uppercase"
            >{c.certificates.sectionLabel}</span
          >
          <h2 class="mt-2 text-3xl font-bold text-stone-900 md:text-4xl">
            {c.certificates.heading}
          </h2>
          <div class="mt-6 space-y-4">
            <div
              class="flex items-start gap-3 rounded-lg border border-stone-200 bg-white/60 p-3"
            >
              <div class="mt-0.5 shrink-0 text-stone-400">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z"
                  ></path></svg
                >
              </div><div>
                <p class="text-sm font-medium text-stone-800">
                  {c.certificates.c1Name}
                </p><p class="text-xs text-stone-500">
                  {c.certificates.c1Org} — {c.certificates.c1Year}
                </p>
              </div>
            </div>
            <div
              class="flex items-start gap-3 rounded-lg border border-stone-200 bg-white/60 p-3"
            >
              <div class="mt-0.5 shrink-0 text-stone-400">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z"
                  ></path></svg
                >
              </div><div>
                <p class="text-sm font-medium text-stone-800">
                  {c.certificates.c2Name}
                </p><p class="text-xs text-stone-500">
                  {c.certificates.c2Org} — {c.certificates.c2Year}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- EDUCATION -->
    <section class="px-6 py-16 md:pr-16 lg:pr-24">
      <span class="text-xs tracking-[0.3em] text-stone-400 uppercase"
        >{c.education.sectionLabel}</span
      >
      <h2 class="mt-2 text-3xl font-bold text-stone-900 md:text-4xl">
        {c.education.heading}
      </h2>
      <div class="mt-8 space-y-6">
        <div class="flex gap-4">
          <div
            class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-stone-200 text-stone-500"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4.26 10.147a60.436 60.436 0 0 0-.491 6.347A48.627 48.627 0 0 1 12 20.904a48.627 48.627 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.57 50.57 0 0 0-2.658-.813A59.905 59.905 0 0 1 12 3.493a59.902 59.902 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5"
              ></path></svg
            >
          </div><div>
            <h3 class="font-semibold text-stone-900">
              {c.education.e1Degree}
            </h3><p class="text-sm text-stone-500">{c.education.e1School}</p><p
              class="text-xs text-stone-400"
            >
              {c.education.e1Year}
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
