---
import Layout from "@/layouts/Layout.astro";
import "@/styles/global.css";
import {
  getIntlayer,
  getLocaleFromPath,
  getPrefix,
  localeMap,
  type LocalesValues,
} from "intlayer";

export const getStaticPaths = () => {
  return localeMap(({ locale }) => ({
    params: { locale: getPrefix(locale).localePrefix },
  }));
};

const locale = getLocaleFromPath(Astro.url.pathname) as LocalesValues;
const c = await getIntlayer("index", locale);
const footer = await getIntlayer("footer", locale);

const techs = [
  "TypeScript",
  "React",
  "Next.js",
  "Python",
  "Django",
  "Laravel",
  "PHP",
  "Node.js",
  "PostgreSQL",
  "MySQL",
  "Tailwind",
  "Docker",
  "Git",
  "REST APIs",
  "Three.js",
  "Astro",
];

const marqueeItems = [
  "FULL STACK ENGINEER",
  "REACT",
  "TYPESCRIPT",
  "PYTHON",
  "DJANGO",
  "NEXT.JS",
  "LARAVEL",
  "NODE.JS",
  "POSTGRESQL",
  "TAILWIND",
  "DOCKER",
  "THREE.JS",
  "ASTRO",
];

// Segmentos de barra de progreso pixel
const pctToSegments = (pct: string) =>
  Math.round((parseInt(pct, 10) / 100) * 20);
---

<Layout locale={locale}>
  <!-- ═══════════════ HERO ═══════════════ -->
  <section class="grid-bg border-line bg-paper relative border-b">
    <div class="px-5 py-16 sm:px-8 md:px-10 md:py-28">
      <div class="max-w-3xl">
        <p
          class="text-ink-soft font-mono text-[0.78rem] tracking-widest uppercase"
        >
          <span class="text-navy">/</span>
          {c.hero.subtitle}<span class="blink text-navy">_</span>
        </p>
        <h1
          class="text-mega text-ink mt-6 text-[2.8rem] leading-none sm:text-7xl md:text-8xl"
        >
          {c.hero.firstName}
          <br />
          <span class="text-navy">{c.hero.lastName}</span>
        </h1>
        <p class="text-ink-soft mt-7 max-w-xl text-[0.98rem] leading-relaxed">
          {c.hero.description}
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a
            href="/José_Manuel_Muñoz_García_Resume_2026.pdf"
            download
            class="btn-brutal w-full px-6 py-3.5 text-center sm:w-auto"
            ><span class="text-cream">[↓]</span> {c.hero.downloadCv}</a
          >
          <a
            href="#contact"
            class="btn-brutal btn-brutal--navy w-full px-6 py-3.5 text-center sm:w-auto"
            ><span class="text-navy">[→]</span> {c.hero.contact}</a
          >
        </div>
      </div>
      <div
        class="border-line text-ink-faint mt-14 flex flex-wrap items-center gap-x-6 gap-y-2 border-t pt-4 font-mono text-[0.68rem] uppercase"
      >
        <span class="flex items-center gap-1.5"
          ><span class="win-dot win-dot--radio blink"></span>STATUS:OPEN</span
        >
        <span>BASE::{footer.location}</span>
        <span>EMAIL::{footer.email}</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════ TICKER ═══════════════ -->
  <div class="border-line bg-navy overflow-hidden border-b py-2.5">
    <div class="animate-marquee flex w-max whitespace-nowrap">
      <div
        class="text-cream/90 flex items-center gap-6 pr-6 font-mono text-[0.72rem] uppercase"
      >
        {
          marqueeItems.map((m) => (
            <span class="flex items-center gap-6">
              <>
                <span>{m}</span>
                <span class="text-peri">/</span>
              </>
            </span>
          ))
        }
      </div>
      <div
        class="text-cream/90 flex items-center gap-6 pr-6 font-mono text-[0.72rem] uppercase"
        aria-hidden="true"
      >
        {
          marqueeItems.map((m) => (
            <span class="flex items-center gap-6">
              <>
                <span>{m}</span>
                <span class="text-peri">/</span>
              </>
            </span>
          ))
        }
      </div>
    </div>
  </div>

  <!-- ═══════════════ ABOUT ═══════════════ -->
  <section
    id="about"
    class="border-line bg-paper-2 border-b px-5 py-16 md:px-10"
  >
    <span class="section-tag">0://{c.about.sectionLabel}</span>
    <h2 class="text-ink mt-5 text-3xl md:text-4xl">
      {c.about.heading}
    </h2>
    <div class="mt-8 grid md:grid-cols-12">
      <div class="border-line bg-paper-3 border p-6 md:col-span-7">
        <p class="text-ink-soft leading-relaxed">{c.about.p1}</p>
        <p class="text-ink-soft mt-4 leading-relaxed">{c.about.p2}</p>
        <div class="dashed-line mt-6"></div>
        <p
          class="text-ink-faint mt-4 font-mono text-[0.7rem] leading-relaxed uppercase"
        >
          $ whoami --full
          <br />
          <span class="text-navy">&gt; MANUEL_MUÑOZ // FULL_STACK_ENGINEER</span
          >
        </p>
      </div>
      <div
        class="border-line bg-paper-3 mt-6 grid grid-cols-3 border md:col-span-5 md:mt-0"
      >
        <div
          class="border-line flex flex-col items-center justify-center border-r p-4 text-center"
        >
          <span class="text-mega text-navy text-2xl md:text-3xl"
            >{c.about.stat1Num}</span
          >
          <span
            class="text-ink-soft mt-2 font-mono text-[0.58rem] leading-tight uppercase"
            >{c.about.stat1Label}</span
          >
        </div>
        <div
          class="border-line flex flex-col items-center justify-center border-r p-4 text-center"
        >
          <span class="text-mega text-navy text-2xl md:text-3xl"
            >{c.about.stat2Num}</span
          >
          <span
            class="text-ink-soft mt-2 font-mono text-[0.58rem] leading-tight uppercase"
            >{c.about.stat2Label}</span
          >
        </div>
        <div class="flex flex-col items-center justify-center p-4 text-center">
          <span class="text-mega text-coral text-2xl md:text-3xl"
            >{c.about.stat3Num}</span
          >
          <span
            class="text-ink-soft mt-2 font-mono text-[0.58rem] leading-tight uppercase"
            >{c.about.stat3Label}</span
          >
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ STACK ═══════════════ -->
  <section id="stack" class="border-line bg-paper border-b px-5 py-16 md:px-10">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="section-tag">1://{c.stack.sectionLabel}</span>
        <h2 class="text-ink mt-5 text-3xl md:text-4xl">
          {c.stack.heading}
        </h2>
      </div>
      <span class="text-ink-faint font-mono text-[0.68rem] uppercase"
        >REG:{techs.length}</span
      >
    </div>
    <div
      class="border-line bg-line mt-8 grid grid-cols-2 gap-px border sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5"
    >
      {
        techs.map((t) => (
          <div class="stack-cell">
            <span>{t}</span>
            <span class="text-[0.6rem] opacity-50">▸</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ═══════════════ TIMELINE ═══════════════ -->
  <section
    id="timeline"
    class="border-line bg-paper-2 border-b px-5 py-16 md:px-10"
  >
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="section-tag">2://{c.timeline.sectionLabel}</span>
        <h2 class="text-ink mt-5 text-3xl md:text-4xl">
          {c.timeline.heading}
        </h2>
      </div>
      <span class="text-ink-faint font-mono text-[0.68rem] uppercase"
        >SINCE_2017</span
      >
    </div>
    <div
      class="border-line bg-paper-3 mt-8 overflow-x-auto border sm:overflow-visible"
    >
      <table class="dense-table sm:min-w-180">
        <thead>
          <tr>
            <th class="w-44">DATE</th>
            <th class="w-48">ROLE</th>
            <th class="w-56">COMPANY</th>
            <th>DESCRIPTION</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td
              data-label="Date"
              class="text-ink-faint font-mono text-[0.72rem] uppercase"
              >{c.timeline.t1Year}</td
            >
            <td data-label="Role" class="text-ink text-[0.9rem] font-medium"
              >{c.timeline.t1Role}</td
            >
            <td data-label="Company" class="text-navy text-[0.85rem]"
              >{c.timeline.t1Company}</td
            >
            <td data-label="Description" class="text-ink-soft text-[0.88rem]"
              >{c.timeline.t1Desc}</td
            >
          </tr>
          <tr>
            <td
              data-label="Date"
              class="text-ink-faint font-mono text-[0.72rem] uppercase"
              >{c.timeline.t2Year}</td
            >
            <td data-label="Role" class="text-ink text-[0.9rem] font-medium"
              >{c.timeline.t2Role}</td
            >
            <td data-label="Company" class="text-navy text-[0.85rem]"
              >{c.timeline.t2Company}</td
            >
            <td data-label="Description" class="text-ink-soft text-[0.88rem]"
              >{c.timeline.t2Desc}</td
            >
          </tr>
          <tr>
            <td
              data-label="Date"
              class="text-ink-faint font-mono text-[0.72rem] uppercase"
              >{c.timeline.t3Year}</td
            >
            <td data-label="Role" class="text-ink text-[0.9rem] font-medium"
              >{c.timeline.t3Role}</td
            >
            <td data-label="Company" class="text-navy text-[0.85rem]"
              >{c.timeline.t3Company}</td
            >
            <td data-label="Description" class="text-ink-soft text-[0.88rem]"
              >{c.timeline.t3Desc}</td
            >
          </tr>
          <tr>
            <td
              data-label="Date"
              class="text-ink-faint font-mono text-[0.72rem] uppercase"
              >{c.timeline.t4Year}</td
            >
            <td data-label="Role" class="text-ink text-[0.9rem] font-medium"
              >{c.timeline.t4Role}</td
            >
            <td data-label="Company" class="text-navy text-[0.85rem]"
              >{c.timeline.t4Company}</td
            >
            <td data-label="Description" class="text-ink-soft text-[0.88rem]"
              >{c.timeline.t4Desc}</td
            >
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- ═══════════════ PROJECTS ═══════════════ -->
  <section
    id="projects"
    class="border-line bg-paper border-b px-5 py-16 md:px-10"
  >
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="section-tag">3://{c.projects.sectionLabel}</span>
        <h2 class="text-ink mt-5 text-3xl md:text-4xl">
          {c.projects.heading}
        </h2>
      </div>
      <span class="text-ink-faint font-mono text-[0.68rem] uppercase"
        >DIR:~/projects</span
      >
    </div>
    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      <article class="proj-card p-6">
        <div
          class="border-line flex items-center justify-between gap-2 border-b pb-2.5"
        >
          <span class="file-tab">FILE://01</span>
          <span class="flex gap-1.5"
            ><span class="win-dot"></span><span class="win-dot win-dot--navy"
            ></span></span
          >
        </div>
        <p class="text-navy mt-4 font-mono text-[0.68rem] uppercase">
          {c.projects.p1Tags}
        </p>
        <h3 class="text-ink mt-2 text-lg">{c.projects.p1Title}</h3>
        <p class="text-ink-soft mt-2 text-[0.9rem] leading-relaxed">
          {c.projects.p1Desc}
        </p>
        <span
          class="text-ink-soft mt-4 inline-flex items-center gap-1.5 font-mono text-[0.72rem] uppercase"
          ><span class="text-navy">/</span> {c.projects.viewLabel}_</span
        >
      </article>
      <article class="proj-card p-6">
        <div
          class="border-line flex items-center justify-between gap-2 border-b pb-2.5"
        >
          <span class="file-tab">FILE://02</span>
          <span class="flex gap-1.5"
            ><span class="win-dot"></span><span class="win-dot win-dot--navy"
            ></span></span
          >
        </div>
        <p class="text-navy mt-4 font-mono text-[0.68rem] uppercase">
          {c.projects.p2Tags}
        </p>
        <h3 class="text-ink mt-2 text-lg">{c.projects.p2Title}</h3>
        <p class="text-ink-soft mt-2 text-[0.9rem] leading-relaxed">
          {c.projects.p2Desc}
        </p>
        <span
          class="text-ink-soft mt-4 inline-flex items-center gap-1.5 font-mono text-[0.72rem] uppercase"
          ><span class="text-navy">/</span> {c.projects.viewLabel}_</span
        >
      </article>
      <article class="proj-card p-6">
        <div
          class="border-line flex items-center justify-between gap-2 border-b pb-2.5"
        >
          <span class="file-tab">FILE://03</span>
          <span class="flex gap-1.5"
            ><span class="win-dot"></span><span class="win-dot win-dot--navy"
            ></span></span
          >
        </div>
        <p class="text-navy mt-4 font-mono text-[0.68rem] uppercase">
          {c.projects.p3Tags}
        </p>
        <h3 class="text-ink mt-2 text-lg">{c.projects.p3Title}</h3>
        <p class="text-ink-soft mt-2 text-[0.9rem] leading-relaxed">
          {c.projects.p3Desc}
        </p>
        <span
          class="text-ink-soft mt-4 inline-flex items-center gap-1.5 font-mono text-[0.72rem] uppercase"
          ><span class="text-navy">/</span> {c.projects.viewLabel}_</span
        >
      </article>
      <article class="proj-card p-6">
        <div
          class="border-line flex items-center justify-between gap-2 border-b pb-2.5"
        >
          <span class="file-tab">FILE://04</span>
          <span class="flex gap-1.5"
            ><span class="win-dot"></span><span class="win-dot win-dot--navy"
            ></span></span
          >
        </div>
        <p class="text-navy mt-4 font-mono text-[0.68rem] uppercase">
          {c.projects.p4Tags}
        </p>
        <h3 class="text-ink mt-2 text-lg">{c.projects.p4Title}</h3>
        <p class="text-ink-soft mt-2 text-[0.9rem] leading-relaxed">
          {c.projects.p4Desc}
        </p>
        <span
          class="text-ink-soft mt-4 inline-flex items-center gap-1.5 font-mono text-[0.72rem] uppercase"
          ><span class="text-navy">/</span> {c.projects.viewLabel}_</span
        >
      </article>
    </div>
  </section>

  <!-- ═══════════════ GITHUB ═══════════════ -->
  <section class="border-line bg-paper-2 border-b px-5 py-16 md:px-10">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="section-tag">4://{c.github.sectionLabel}</span>
        <h2 class="text-ink mt-5 text-3xl md:text-4xl">
          {c.github.heading}
        </h2>
      </div>
      <span class="text-ink-faint font-mono text-[0.68rem] uppercase"
        >SOURCE:GH</span
      >
    </div>
    <div class="win-window mt-8 max-w-3xl">
      <div class="win-titlebar">
        <span class="win-dot"></span>
        <span>GITHUB://CONTRIBUTIONS.EXE</span>
        <span class="ml-auto"
          ><span class="win-dot win-dot--radio blink"></span></span
        >
      </div>
      <div class="bg-paper-2 p-3">
        <img
          src={`https://ghchart.rshah.org/${c.github.username}`}
          alt="GitHub contribution graph"
          class="w-full"
          loading="lazy"
        />
      </div>
      <div
        class="border-line bg-paper text-ink-faint flex flex-wrap items-center gap-2 border-t px-3 py-2.5 font-mono text-[0.7rem] uppercase"
      >
        <span class="text-navy">$</span> gh user {c.github.username}
        <a
          href={`https://github.com/${c.github.username}`}
          target="_blank"
          rel="noopener"
          class="link-90s ml-auto">github.com/{c.github.username}</a
        >
      </div>
    </div>
  </section>

  <!-- ═══════════════ LANGUAGES + CERTIFICATES ═══════════════ -->
  <section class="border-line bg-paper border-b px-5 py-16 md:px-10">
    <div class="grid gap-10 md:grid-cols-2">
      <!-- LANGUAGES -->
      <div>
        <span class="section-tag">5://{c.languages.sectionLabel}</span>
        <h2 class="text-ink mt-5 text-3xl md:text-4xl">
          {c.languages.heading}
        </h2>
        <div class="mt-8 space-y-5">
          <div class="border-line bg-paper-3 border p-5">
            <div
              class="flex items-center justify-between gap-2 font-mono text-[0.72rem] uppercase"
            >
              <span class="text-ink">{c.languages.l1Name}</span>
              <span class="text-navy">{c.languages.l1Level}</span>
            </div>
            <div class="pixel-progress mt-3.5">
              {
                Array.from({ length: 20 }).map((_, i) => (
                  <span
                    class={i < pctToSegments(c.languages.l1Pct) ? "hot" : "off"}
                  />
                ))
              }
            </div>
          </div>
          <div class="border-line bg-paper-3 border p-5">
            <div
              class="flex items-center justify-between gap-2 font-mono text-[0.72rem] uppercase"
            >
              <span class="text-ink">{c.languages.l2Name}</span>
              <span class="text-coral">{c.languages.l2Level}</span>
            </div>
            <div class="pixel-progress mt-3.5">
              {
                Array.from({ length: 20 }).map((_, i) => (
                  <span
                    class={i < pctToSegments(c.languages.l2Pct) ? "hot" : "off"}
                  />
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <!-- CERTIFICATES -->
      <div>
        <span class="section-tag">6://{c.certificates.sectionLabel}</span>
        <h2 class="text-ink mt-5 text-3xl md:text-4xl">
          {c.certificates.heading}
        </h2>
        <div class="mt-8 space-y-5">
          <div
            class="border-line bg-paper-3 flex items-start gap-3.5 border p-5"
          >
            <span
              class="border-navy text-navy mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center border font-mono text-[0.62rem]"
              >✓</span
            >
            <div>
              <p class="text-ink font-mono text-[0.75rem] uppercase">
                {c.certificates.c1Name}
              </p>
              <p class="text-ink-soft mt-1 text-[0.82rem]">
                {c.certificates.c1Org} — {c.certificates.c1Year}
              </p>
            </div>
          </div>
          <div
            class="border-line bg-paper-3 flex items-start gap-3.5 border p-5"
          >
            <span
              class="border-navy text-navy mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center border font-mono text-[0.62rem]"
              >✓</span
            >
            <div>
              <p class="text-ink font-mono text-[0.75rem] uppercase">
                {c.certificates.c2Name}
              </p>
              <p class="text-ink-soft mt-1 text-[0.82rem]">
                {c.certificates.c2Org} — {c.certificates.c2Year}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ EDUCATION ═══════════════ -->
  <section class="border-line bg-paper-2 border-b px-5 py-16 md:px-10">
    <span class="section-tag">7://{c.education.sectionLabel}</span>
    <h2 class="text-ink mt-5 text-3xl md:text-4xl">
      {c.education.heading}
    </h2>
    <div class="border-line bg-paper-3 mt-8 max-w-2xl border">
      <div class="grid sm:grid-cols-[110px_1fr]">
        <div
          class="border-line bg-navy flex items-center justify-center border-b p-5 sm:border-r sm:border-b-0"
        >
          <span
            class="text-mega border-cream/60 text-cream flex h-12 w-12 items-center justify-center border text-lg"
            >[]</span
          >
        </div>
        <div class="p-6">
          <h3 class="text-ink text-lg leading-relaxed">
            {c.education.e1Degree}
          </h3>
          <p class="text-ink-soft mt-1.5 text-[0.85rem]">
            {c.education.e1School}
          </p>
          <p class="text-ink-faint mt-2 font-mono text-[0.7rem] uppercase">
            PERIOD::{c.education.e1Year}
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
