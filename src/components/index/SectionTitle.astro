---
interface Props {
  number: number;
  label: string;
  title: string;
}

const { number, label, title } = Astro.props;
---

<div class="flex flex-col gap-1 md:gap-2">
  <h2
    class="text-caption w-full align-baseline font-mono font-light text-black uppercase"
  >
    <span class="text-navy">█</span>{" "}
    {number}://{" "}
    <span class="text-navy">{label}</span>
  </h2>
  <h3 class="text-h2">{title}</h3>
</div>
