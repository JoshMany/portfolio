---
import { type LocalesValues } from "intlayer";

interface Props {
  locale: LocalesValues;
  number: number;
  label: string;
  title: string;
}

const { number, label, title } = Astro.props;
---

<div class="flex flex-col gap-1 md:gap-2">
  <h2
    class="w-full align-baseline font-mono text-[3.5vw] font-light text-black uppercase md:text-lg"
  >
    <span class="text-navy">█</span>{" "}
    {number}://{" "}
    <span class="text-navy">{label}</span>
  </h2>
  <h3 class="text-[7vw] leading-tight md:text-4xl">{title}</h3>
</div>
