---

---

<div
  id="three-scene"
  class="absolute inset-0 -z-10 h-[60vh] w-full text-white md:fixed md:top-0 md:left-0 md:h-screen md:w-1/2"
>
</div>

<script>
  import * as THREE from "three";
  import { GLTFLoader } from "three/examples/jsm/loaders/GLTFLoader.js";
  import { EffectComposer } from "three/examples/jsm/postprocessing/EffectComposer.js";
  import { RenderPass } from "three/examples/jsm/postprocessing/RenderPass.js";
  import { RenderPixelatedPass } from "three/examples/jsm/postprocessing/RenderPixelatedPass.js";
  import { ShaderPass } from "three/examples/jsm/postprocessing/ShaderPass.js";
  import { OutputPass } from "three/examples/jsm/postprocessing/OutputPass.js";

  const container = document.getElementById("three-scene")!;

  const scene = new THREE.Scene();

  // ── Mobile detection ─────────────────────────────────────────
  const isMobile = window.matchMedia("(max-width: 767px)").matches;
  const modelScale = isMobile ? 1.5 : 1.2;

  // Margen interior (px) para que el modelo no toque los bordes en mobile
  const MOBILE_MARGIN = 28;
  const MARGIN = isMobile ? MOBILE_MARGIN : 0;

  // Área de dibujo: contenedor menos el margen (para separar del borde)
  const getDrawSize = () => ({
    w: Math.max(1, container.clientWidth - MARGIN * 2),
    h: Math.max(1, container.clientHeight - MARGIN * 2),
  });

  const camera = new THREE.PerspectiveCamera(75, 1, 0.1, 1000);

  const loader = new GLTFLoader();
  let model: THREE.Group | null = null;

  loader.load("/chango.glb", (gltf) => {
    model = gltf.scene;
    model.scale.set(modelScale, modelScale, modelScale);
    // Ajustar materiales para mejor respuesta a luz = más contraste ASCII
    model.traverse((child) => {
      if (child instanceof THREE.Mesh && child.material) {
        const mat = child.material as THREE.MeshStandardMaterial;
        mat.roughness = 0.5;
        mat.metalness = 0.1;
      }
    });
    scene.add(model);
  });

  const renderer = new THREE.WebGLRenderer();

  // ── Post-procesado: pixelado retro ──────────────────────────
  // Compone la escena a baja resolución y la escala con filtro de vecino
  // más cercano (efecto "píxel"). El OutputPass aplica corrección de color.
  const composer = new EffectComposer(renderer);
  composer.addPass(new RenderPass(scene, camera));
  const pixelSize = isMobile ? 8 : 12; // más alto = píxeles más grandes/retro
  composer.addPass(new RenderPixelatedPass(pixelSize, scene, camera));

  // ── Pass de escala de grises (blanco y negro) ────────────────
  // Convierte cualquier color del objeto a B/N garantizado.
  const GrayscaleShader = {
    uniforms: { tDiffuse: { value: null } },
    vertexShader: /* glsl */ `
      varying vec2 vUv;
      void main() {
        vUv = uv;
        gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
      }
    `,
    fragmentShader: /* glsl */ `
      uniform sampler2D tDiffuse;
      varying vec2 vUv;
      void main() {
        vec4 color = texture2D(tDiffuse, vUv);
        float gray = dot(color.rgb, vec3(0.299, 0.587, 0.114));
        gl_FragColor = vec4(vec3(gray), color.a);
      }
    `,
  };
  composer.addPass(new ShaderPass(GrayscaleShader));
  composer.addPass(new OutputPass());

  const applySize = () => {
    const { w, h } = getDrawSize();
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
    // En esta versión de three, EffectComposer.setSize NO redimensiona el
    // canvas del renderer, así que hay que hacerlo explícitamente.
    renderer.setSize(w, h);
    composer.setSize(w, h);
  };
  applySize();

  // El canvas del renderer muestra el resultado ya pixelado
  container.appendChild(renderer.domElement);

  // ── Lights ──────────────────────────────────────────────────
  // Ambient muy bajo = sombras profundas = alto contraste
  const ambient = new THREE.AmbientLight(0x111133, 0.08);
  scene.add(ambient);

  // Luz principal: cálida, lateral, intensidad moderada
  const pointLight = new THREE.PointLight(0xff9944, 80, 10);
  pointLight.position.set(2.5, 2, 3);
  scene.add(pointLight);

  // Rim light: trasera, fría, muy sutil — solo delinea la silueta
  const rimLight = new THREE.PointLight(0x4488cc, 25, 6);
  rimLight.position.set(-2, 0.5, -1);
  scene.add(rimLight);

  // Esfera indicadora de la posición de la luz
  const lightMarker = new THREE.Mesh(
    new THREE.SphereGeometry(0.12, 8, 8),
    new THREE.MeshBasicMaterial({ color: 0xff8844 }),
  );
  lightMarker.position.copy(pointLight.position);
  scene.add(lightMarker);

  camera.position.z = isMobile ? 3.5 : 3;

  // ── Mouse tracking ──────────────────────────────────────────
  let targetX = 0;
  let targetY = 0;
  let currentX = 0;
  let currentY = 0;

  window.addEventListener("mousemove", (e) => {
    // Normalizar posición del mouse a [-1, 1] respecto al viewport
    targetX = (e.clientX / window.innerWidth) * 2 - 1;
    targetY = -(e.clientY / window.innerHeight) * 2 + 1;
  });

  function animate(time: number) {
    const t = time / 1000;

    // Suavizado del seguimiento al cursor (lerp)
    currentX += (targetX - currentX) * 0.03;
    currentY += (targetY - currentY) * 0.03;

    if (model) {
      // Rotación base (π/6 ≈ 30°) + micro-ajuste por cursor (±11°)
      model.rotation.y = Math.PI / 6 + currentX * 0.2;
      model.rotation.x = -currentY * 0.1;

      if (isMobile) {
        // Respiración: estiramiento vertical sutil (inhalar/exhalar) + leve balanceo
        const breath = Math.sin(t * 0.8); // ciclo completo ≈ 4s
        model.scale.set(
          modelScale * (1 + breath * 0.02), // X
          modelScale * (1 + breath * 0.05), // Y (más pronunciado)
          modelScale * (1 + breath * 0.02), // Z
        );
        model.position.y = breath * 0.04;
      }
    }

    // Render con post-procesado pixelado
    composer.render();
  }
  renderer.setAnimationLoop(animate);

  window.addEventListener("resize", () => {
    applySize();
  });
</script>

<style>
  #three-scene {
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #three-scene canvas {
    display: block;
    max-width: 100%;
    max-height: 100%;
  }
</style>
