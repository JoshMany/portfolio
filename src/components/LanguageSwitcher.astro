---
import { type LocalesValues } from "intlayer";

interface Props {
  locale: LocalesValues;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;

// Quitar el prefijo de idioma actual del path
const pathWithoutLocale = currentPath.replace(/^\/(en|es)/, "") || "/";
---

<span
  class="ml-2 flex items-center gap-1 rounded-lg border border-gray-700 bg-white/5 p-1 text-xs font-medium"
>
  <a
    href={`/en${pathWithoutLocale}`}
    class={`rounded px-2 py-1 transition ${locale === "en" ? "bg-white text-black" : "text-gray-400 hover:text-white"}`}
    >EN</a
  >
  <a
    href={`/es${pathWithoutLocale}`}
    class={`rounded px-2 py-1 transition ${locale === "es" ? "bg-white text-black" : "text-gray-400 hover:text-white"}`}
    }>ES</a
  >
</span>
