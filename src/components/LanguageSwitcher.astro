---
import { type LocalesValues } from "intlayer";

interface Props {
  locale: LocalesValues;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;

// Quitar el prefijo de idioma actual del path
const pathWithoutLocale = currentPath.replace(/^\/(en|es)/, "") || "/";
---

<div
  class="border-cream/60 flex items-stretch border font-mono text-[0.68rem]"
  role="group"
  aria-label="Language switcher"
>
  <a
    href={`/en${pathWithoutLocale}`}
    class={`flex items-center px-2 py-0.5 uppercase transition ${
      locale === "en"
        ? "bg-radio text-ink"
        : "text-cream/80 hover:bg-cream hover:text-navy"
    }`}
    aria-current={locale === "en" ? "true" : undefined}>EN</a
  >
  <a
    href={`/es${pathWithoutLocale}`}
    class={`flex items-center px-2 py-0.5 uppercase transition ${
      locale === "es"
        ? "bg-radio text-ink"
        : "text-cream/80 hover:bg-cream hover:text-navy"
    }`}
    aria-current={locale === "es" ? "true" : undefined}>ES</a
  >
</div>
