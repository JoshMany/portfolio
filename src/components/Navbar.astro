---
import { type LocalesValues } from "intlayer";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";

interface Props {
  locale: LocalesValues;
  content: Record<string, string>;
  currentPath: string;
}

const { locale, content: nav, currentPath } = Astro.props;

const links = [
  { href: nav.link1Href, label: nav.link1Label },
  { href: nav.link2Href, label: nav.link2Label },
  { href: nav.link3Href, label: nav.link3Label },
  { href: nav.link4Href, label: nav.link4Label },
  { href: nav.link5Href, label: nav.link5Label },
];
---

<nav
  class="bg-paper border-navy sticky top-0 z-40 border-b"
  aria-label="Main navigation"
>
  <div
    class="mx-auto flex w-full max-w-7xl items-center justify-between gap-4 px-5 py-3 sm:px-8 md:px-10"
  >
    <a
      href={locale === "es" ? "/es" : "/en"}
      class="text-ink text-detail font-mono font-semibold tracking-tight uppercase"
      >Manuel Muñoz<span class="text-navy">.</span></a
    >

    <!-- Enlaces de escritorio -->
    <div class="hidden items-center gap-x-5 md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-ink-soft hover:text-navy text-caption font-mono uppercase transition"
          >
            {link.label}
          </a>
        ))
      }
      <div class="flex items-center gap-2">
        <LanguageSwitcher locale={locale} currentPath={currentPath} />
        <ThemeToggle />
      </div>
    </div>

    <!-- Botón menú móvil -->
    <button
      id="nav-toggle"
      class="border-navy text-navy hover:bg-paper-2 flex h-9 w-9 items-center justify-center border transition md:hidden"
      aria-label={locale === "es" ? "Abrir menú" : "Open menu"}
      aria-expanded="false"
      aria-controls="nav-mobile"
    >
      <svg
        id="nav-icon-open"
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="square"><path d="M4 6h16M4 12h16M4 18h16"></path></svg
      >
      <svg
        id="nav-icon-close"
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="square"
        class="hidden"><path d="M6 6l12 12M18 6L6 18"></path></svg
      >
    </button>
  </div>

  <!-- Menú móvil desplegable -->
  <div id="nav-mobile" class="border-line bg-paper hidden border-t md:hidden">
    <div class="flex flex-col px-5 py-4">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="border-line text-ink-soft hover:text-navy text-caption border-b py-3 font-mono uppercase transition last:border-b-0"
          >
            {link.label}
          </a>
        ))
      }
      <div class="mt-4 flex items-center gap-2">
        <LanguageSwitcher locale={locale} currentPath={currentPath} />
        <ThemeToggle />
      </div>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-mobile");
  const iconOpen = document.getElementById("nav-icon-open");
  const iconClose = document.getElementById("nav-icon-close");

  if (toggle && menu) {
    const close = () => {
      menu.classList.add("hidden");
      toggle.setAttribute("aria-expanded", "false");
      if (iconOpen) iconOpen.classList.remove("hidden");
      if (iconClose) iconClose.classList.add("hidden");
    };

    toggle.addEventListener("click", () => {
      const isOpen = !menu.classList.contains("hidden");
      if (isOpen) {
        close();
      } else {
        menu.classList.remove("hidden");
        toggle.setAttribute("aria-expanded", "true");
        if (iconOpen) iconOpen.classList.add("hidden");
        if (iconClose) iconClose.classList.remove("hidden");
      }
    });

    menu
      .querySelectorAll("a")
      .forEach((a) => a.addEventListener("click", close));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });
  }
</script>
