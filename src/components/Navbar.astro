---
import { type LocalesValues } from "intlayer";

interface Props {
  locale: LocalesValues;
  content: Record<string, string>;
  currentPath: string;
}

const { content: nav } = Astro.props;
---

<nav
  class="border-line bg-paper sticky top-7 z-40 border-b"
  aria-label="Main navigation"
>
  <div class="border-line flex flex-wrap items-stretch border-t">
    <span
      class="border-line text-navy flex items-center gap-2 border-r px-3 py-2 font-mono text-[0.7rem]"
      >■<span class="blink">_</span></span
    >
    <a
      href={nav.link1Href}
      class="group border-line text-ink-soft hover:bg-navy hover:text-cream flex items-center gap-1.5 border-r px-3 py-2 font-mono text-[0.72rem] uppercase transition"
      ><span class="text-ink-faint group-hover:text-cream">01</span>
      {nav.link1Label}</a
    >
    <a
      href={nav.link2Href}
      class="group border-line text-ink-soft hover:bg-navy hover:text-cream flex items-center gap-1.5 border-r px-3 py-2 font-mono text-[0.72rem] uppercase transition"
      ><span class="text-ink-faint group-hover:text-cream">02</span>
      {nav.link2Label}</a
    >
    <a
      href={nav.link3Href}
      class="group border-line text-ink-soft hover:bg-navy hover:text-cream flex items-center gap-1.5 border-r px-3 py-2 font-mono text-[0.72rem] uppercase transition"
      ><span class="text-ink-faint group-hover:text-cream">03</span>
      {nav.link3Label}</a
    >
    <a
      href={nav.link4Href}
      class="group border-line text-ink-soft hover:bg-navy hover:text-cream flex items-center gap-1.5 border-r px-3 py-2 font-mono text-[0.72rem] uppercase transition"
      ><span class="text-ink-faint group-hover:text-cream">04</span>
      {nav.link4Label}</a
    >
    <a
      href={nav.link5Href}
      class="group border-line text-ink-soft hover:bg-navy hover:text-cream flex items-center gap-1.5 border-r px-3 py-2 font-mono text-[0.72rem] uppercase transition"
      ><span class="text-ink-faint group-hover:text-cream">05</span>
      {nav.link5Label}</a
    >
    <span
      class="text-ink-faint ml-auto hidden items-center gap-2 px-3 py-2 font-mono text-[0.68rem] uppercase lg:flex"
      ><span class="win-dot win-dot--navy"></span> v2.2</span
    >
  </div>
</nav>
