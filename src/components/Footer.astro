---
import { type LocalesValues } from "intlayer";

interface Props {
  locale: LocalesValues;
  content: Record<string, string>;
}

const { locale, content: f } = Astro.props;
---

<footer id="contact" class="border-line bg-navy text-cream relative border-t">
  <div class="px-5 py-12 md:px-10 md:py-16">
    <div class="grid gap-12 md:grid-cols-2 md:gap-10">
      <!-- Contacto -->
      <div>
        <span class="section-tag section-tag--cream">8://CONTACT</span>
        <h2 class="text-mega text-cream text-display-sm mt-5">
          {f.heading}
        </h2>
        <p class="text-cream/80 text-body mt-4 max-w-sm">
          {f.description}
        </p>
        <div class="border-cream/25 bg-navy mt-8 border">
          <a
            href={`mailto:${f.email}`}
            class="group border-cream/25 hover:bg-cream hover:text-navy flex flex-col gap-1 border-b p-4 transition sm:flex-row sm:items-center sm:justify-between"
          >
            <span
              class="text-peri text-meta group-hover:text-navy font-mono uppercase"
              >EMAIL://</span
            >
            <span class="text-cream text-detail group-hover:text-navy break-all"
              >{f.email}</span
            >
          </a>
          <p
            class="flex flex-col gap-1 p-4 sm:flex-row sm:items-center sm:justify-between"
          >
            <span class="text-peri text-meta font-mono uppercase">LOC://</span>
            <span class="text-cream text-detail">{f.location}</span>
          </p>
        </div>
      </div>

      <!-- Redes -->
      <div>
        <span class="section-tag section-tag--cream">9://{f.linksLabel}</span>
        <p class="text-cream/80 text-caption mt-5 font-mono uppercase">
          <span class="text-peri">$</span> open --links
        </p>
        <div class="border-cream/25 mt-4 flex flex-col border">
          {
            [
              {
                href: "https://github.com/JoshMany",
                label: "GitHub",
                code: "GH",
                icon: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>',
              },
              {
                href: "https://linkedin.com/in/joshmany/",
                label: "LinkedIn",
                code: "IN",
                icon: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>',
              },
              {
                href: "/José_Manuel_Muñoz_García_Resume_2026.pdf",
                label: "CV PDF",
                code: "CV",
                download: true,
              },
            ].map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener"
                download={link.download || undefined}
                class="group hover:bg-cream hover:text-navy border-cream/25 flex items-center justify-between gap-3 border-b p-3.5 transition last:border-b-0"
              >
                <span class="flex items-center gap-3">
                  <span class="border-cream/40 text-cream group-hover:border-navy group-hover:text-navy flex h-8 w-8 shrink-0 items-center justify-center border transition">
                    {link.icon ? (
                      <span
                        class="[&>svg]:h-4 [&>svg]:w-4"
                        set:html={link.icon}
                      />
                    ) : (
                      <span class="text-meta font-mono">{link.code}</span>
                    )}
                  </span>
                  <span class="text-meta group-hover:text-navy font-mono uppercase">
                    {link.label}
                  </span>
                </span>
                <span
                  class="text-peri text-meta group-hover:text-navy font-mono"
                  aria-hidden="true"
                >
                  →
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <!-- Barra de estado final (tinta) -->
  <div
    class="border-cream/20 bg-ink text-cream/80 text-meta flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-t px-4 py-3 font-mono tracking-widest uppercase"
  >
    <span class="w-full sm:w-auto">
      {f.copyright.replace("{year}", String(new Date().getFullYear()))}
    </span>
    <span class="flex items-center gap-1.5"></span>v2.2
  </div>
</footer>
