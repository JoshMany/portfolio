---
import { type LocalesValues } from "intlayer";

interface Props {
  locale: LocalesValues;
  content: Record<string, string>;
}

const { locale, content: f } = Astro.props;
---

<footer id="contact" class="relative z-10 bg-neutral-900 text-gray-400">
  <div
    class="mx-auto max-w-6xl px-6 py-16 md:grid md:grid-cols-2 md:gap-12 md:py-24"
  >
    <!-- Contacto -->
    <div>
      <h2 class="text-2xl font-bold text-white md:text-3xl">{f.heading}</h2>
      <p class="mt-3 max-w-sm leading-relaxed text-gray-500">
        {f.description}
      </p>

      <div class="mt-8 space-y-4">
        <a
          href={`mailto:${f.email}`}
          class="flex items-center gap-3 text-gray-500 transition hover:text-white"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
            ></path></svg
          >
          {f.email}
        </a>
        <p class="flex items-center gap-3 text-gray-500">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
            ></path></svg
          >
          {f.location}
        </p>
      </div>
    </div>

    <!-- Redes & recursos -->
    <div class="mt-12 md:mt-0">
      <h3 class="text-sm tracking-[0.2em] text-gray-500 uppercase">
        {f.linksLabel}
      </h3>

      <!-- Social links -->
      <div class="mt-6 flex flex-wrap gap-4">
        {
          [
            {
              href: "https://github.com/JoshMany",
              label: "GitHub",
              icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>',
            },
            {
              href: "https://linkedin.com/in/joshmany/",
              label: "LinkedIn",
              icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>',
            },
            {
              href: "/José_Manuel_Muñoz_García_Resume_2026.pdf",
              label: "CV PDF",
              icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/></svg>',
              download: true,
            },
          ].map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener"
              download={link.download || undefined}
              class="flex items-center gap-2 rounded-lg border border-gray-700 px-4 py-2.5 text-sm font-medium text-gray-500 transition hover:border-gray-500 hover:text-white"
            >
              <span class="[&>svg]:h-5 [&>svg]:w-5" set:html={link.icon} />
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Copyright -->
  <div
    class="border-t border-gray-800 px-6 py-6 text-center text-sm text-gray-500"
  >
    <p>
      {f.copyright.replace("{year}", String(new Date().getFullYear()))}
    </p>
  </div>
</footer>
