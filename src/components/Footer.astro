---
import { type LocalesValues } from "intlayer";

interface Props {
  locale: LocalesValues;
  content: Record<string, string>;
}

const { locale, content: f } = Astro.props;
---

<footer id="contact" class="border-line bg-navy relative border-t">
  <div class="px-5 py-12 md:px-10 md:py-16">
    <div class="grid gap-12 md:grid-cols-2 md:gap-10">
      <!-- Contacto -->
      <div>
        <span class="section-tag">8://CONTACT</span>
        <h2 class="text-mega text-cream mt-5 text-4xl md:text-6xl">
          {f.heading}
        </h2>
        <p class="text-cream/80 mt-4 max-w-sm text-[0.95rem]">
          {f.description}
        </p>
        <div class="border-cream/40 bg-navy mt-8 border">
          <a
            href={`mailto:${f.email}`}
            class="border-cream/40 hover:bg-cream hover:text-navy flex flex-col gap-1 border-b p-4 transition sm:flex-row sm:items-center sm:justify-between"
          >
            <span class="text-peri font-mono text-[0.7rem] uppercase"
              >EMAIL://</span
            >
            <span class="text-cream text-[0.92rem] break-all">{f.email}</span>
          </a>
          <p
            class="flex flex-col gap-1 p-4 sm:flex-row sm:items-center sm:justify-between"
          >
            <span class="text-peri font-mono text-[0.7rem] uppercase"
              >LOC://</span
            >
            <span class="text-cream text-[0.92rem]">{f.location}</span>
          </p>
        </div>
      </div>

      <!-- Redes -->
      <div>
        <span class="section-tag">9://{f.linksLabel}</span>
        <p class="text-cream/80 mt-5 font-mono text-[0.75rem] uppercase">
          <span class="text-peri">$</span> open --links
        </p>
        <div class="mt-4 grid grid-cols-3 gap-3">
          {
            [
              {
                href: "https://github.com/JoshMany",
                label: "GitHub",
                code: "GH",
              },
              {
                href: "https://linkedin.com/in/joshmany/",
                label: "LinkedIn",
                code: "IN",
              },
              {
                href: "/José_Manuel_Muñoz_García_Resume_2026.pdf",
                label: "CV PDF",
                code: "CV",
                download: true,
              },
            ].map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener"
                download={link.download || undefined}
                class="group border-cream/50 hover:bg-cream hover:text-navy flex flex-col items-center gap-2.5 border px-2 py-4 text-center transition sm:items-start sm:px-4 sm:text-left"
              >
                <span class="border-cream/60 text-cream group-hover:border-navy group-hover:text-navy flex h-9 w-9 items-center justify-center border font-mono text-[0.7rem] transition">
                  {link.code}
                </span>
                <span class="font-mono text-[0.68rem] uppercase">
                  {link.label}
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <!-- Barra de estado final (tinta) -->
  <div
    class="border-cream/30 bg-ink text-cream/80 flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-t px-4 py-3 font-mono text-[0.68rem] tracking-widest uppercase"
  >
    <span class="w-full sm:w-auto">
      {f.copyright.replace("{year}", String(new Date().getFullYear()))}
    </span>
    <span class="hidden sm:inline">BUILT_WITH:ASTRO/INTLAYER</span>
    <span class="flex items-center gap-1.5"
      ><span class="win-dot win-dot--radio blink"></span>v2.2</span
    >
  </div>
</footer>
